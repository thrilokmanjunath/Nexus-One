# ============================================================
# Nexus-One Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — App will refuse to start without these
# ----------------------------------------------------------
SECRET_KEY=replace_with_a_strong_random_secret

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
# For local dev without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ----------------------------------------------------------
# AI / LLM Providers (at least one required for AI features)
# ----------------------------------------------------------
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=xxxx
ANTHROPIC_API_KEY=sk-xxxx

# Default model used by agents and GenAI service
DEFAULT_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Optional Services
# ----------------------------------------------------------

# Redis (caching & rate limiting)
REDIS_URI=redis://localhost:6379/0

# MLflow experiment tracking
MLFLOW_TRACKING_URI=file:///tmp/mlruns

# CORS (comma-separated origins for production)
# BACKEND_CORS_ORIGINS=["https://your-frontend.vercel.app"]

# Frontend API endpoint (set in Vercel env vars)
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
